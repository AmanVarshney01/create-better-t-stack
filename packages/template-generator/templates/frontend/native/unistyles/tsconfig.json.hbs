{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    {{#if (and (eq api "orpc") (ne backend "convex") (ne backend "none"))}}
    "noUncheckedIndexedAccess": true,
    {{/if}}
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
