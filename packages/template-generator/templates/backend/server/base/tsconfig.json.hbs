{
  {{#if (and (eq api "orpc") (ne backend "convex") (ne backend "none"))}}
  "references": [{ "path": "../../packages/api" }],
  {{/if}}
  "extends": "@{{projectName}}/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
		"outDir": "dist",
		"paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"{{#if (eq backend "hono")}},
    "jsxImportSource": "hono/jsx"{{/if}}
  }
}
