{
  "name": "@{{projectName}}/auth",
  "exports": {
    ".": {
      {{#if (eq api "orpc")}}
      "types": "./dist/src/index.d.ts",
      {{/if}}
      "default": "./src/index.ts"
    },
    "./*": {
      {{#if (eq api "orpc")}}
      "types": "./dist/src/*.d.ts",
      {{/if}}
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {}
}