{
  "extends": "@{{projectName}}/config/tsconfig.base.json",
  {{#if (eq api "orpc")}}
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "references": [{{#if (ne database "none")}}{ "path": "../db" }{{/if}}]
  {{else}}
  "compilerOptions": {
    "noEmit": true
  }
  {{/if}}
}
